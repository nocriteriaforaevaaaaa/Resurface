# Copy to .env and adjust as needed.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://evidence_user:evidence_pass@localhost:5432/evidence_db

# --- Models ---
WHISPER_MODEL_NAME=small
OPEN_CLIP_MODEL_NAME=ViT-B-32
OPEN_CLIP_PRETRAINED=laion2b_s34b_b79k
OCR_ENGINE=easyocr

# --- Retrieval ---
FAISS_TOP_K=50
PHASH_HAMMING_THRESHOLD=10
MIN_FINAL_SCORE_FOR_MATCH=0.55
MIN_SOURCE_RELIABILITY_FOR_DECISION=0.4

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Device: auto | cpu | mps | cuda ---
TORCH_DEVICE=auto
